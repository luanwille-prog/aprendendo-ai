<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{% block titulo %}Aprendendo AI{% endblock %}</title>
<meta name="description" content="Resumos diários dos talks do canal AI Engineer, explicados no estilo Quadro Anotado.">
<link rel="icon" href="{{ raiz }}favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/atom+xml" title="Aprendendo AI: edições" href="{{ raiz }}feed.xml">
<script>document.documentElement.classList.add("js");try{var t=localStorage.getItem("tema");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@300;500;700;900&family=Barlow:ital,wght@0,400;0,500;0,600;1,400&family=Kalam:wght@400;700&display=swap">
<link rel="stylesheet" href="{{ raiz }}estilo.css">
</head>
<body class="pg-{{ pagina }}">
<a class="pular" href="#conteudo">Pular para o conteúdo</a>
<header class="topo wrap">
  <a class="marca" href="{{ raiz }}index.html">Aprendendo <span>AI</span></a>
  <nav class="topo-links" aria-label="Navegação principal">
    <a href="{{ raiz }}index.html#edicoes"{% if pagina in ("home", "edicao", "semana") %} aria-current="page"{% endif %}>Edições</a>
    <a href="{{ raiz }}talks.html"{% if pagina == "talks" %} aria-current="page"{% endif %}>Talks</a>
    <a href="{{ raiz }}glossario.html"{% if pagina == "glossario" %} aria-current="page"{% endif %}>Glossário</a>
    <button type="button" class="tema-botao js-only" aria-label="Tema de cores: automático">◐</button>
  </nav>
</header>
<main id="conteudo" class="wrap" tabindex="-1">
{% block conteudo %}{% endblock %}
</main>
<footer class="rodape wrap">
  <p>Resumos em português dos talks do canal <a href="https://www.youtube.com/@aiDotEngineer" target="_blank" rel="noopener">AI Engineer<span class="sr"> (abre em nova aba)</span></a>.{% if execucao %} Atualizado em {{ execucao.em_fmt }}.{% endif %} <a href="{{ raiz }}status.html">Status da rotina</a> · <a href="{{ raiz }}feed.xml">Assinar por RSS</a></p>
</footer>
<script src="{{ raiz }}app.js" defer></script>
</body>
</html>
