{% extends "_base.html.j2" %}
{% block titulo %}Página não encontrada · Aprendendo AI{% endblock %}
{% block conteudo %}
<header class="hero hero-curto">
  <span class="label">Erro 404</span>
  <h1>Página não encontrada</h1>
  <p class="hand">esse endereço não existe (ou a edição ainda não saiu)</p>
</header>
<div class="card vazio">
  <p>As edições saem todo dia às 7h, com os talks publicados na véspera. Talvez você queira:</p>
  <ul class="acoes">
    {% if atual %}<li><a href="{{ raiz }}edicoes/{{ atual.edicao }}.html">Ler a última edição: {{ atual.titulo }}</a></li>{% endif %}
    <li><a href="{{ raiz }}index.html#edicoes">Ver todas as edições</a></li>
    <li><a href="{{ raiz }}glossario.html">Abrir o glossário</a></li>
  </ul>
</div>
{% endblock %}
