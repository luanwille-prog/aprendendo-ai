{% extends "_base.html.j2" %}
{% block conteudo %}
<header class="hero">
  <span class="label">Estudo diário · canal AI Engineer</span>
  <h1>Aprendendo <span class="risco">AI</span></h1>
  <p class="hand">um talk por bloco, explicado como numa aula particular</p>
</header>

{% if atual %}
<section class="destaque card" aria-labelledby="destaque-titulo">
  <span class="label">Última edição · {{ atual.data_fmt }} · {{ atual.videos|length }} {{ "vídeo" if atual.videos|length == 1 else "vídeos" }}</span>
  <h2 id="destaque-titulo">{{ atual.titulo }}</h2>
  {% if atual.dia %}<p class="abertura">{{ atual.dia.abertura }}</p>{% endif %}
  <ol class="lista-talks">
    {% for v in atual.videos %}
    <li><a href="edicoes/{{ atual.edicao }}.html#v-{{ v.id }}">{{ v.titulo_curto }}</a> <span class="muted">· {{ TEMAS.get(v.tema, v.tema) }} · {{ v.duracao|tempo }}</span></li>
    {% endfor %}
  </ol>
  <div class="destaque-rodape">
    <a class="botao" href="edicoes/{{ atual.edicao }}.html">Ler a edição →</a>
    <span class="progresso" data-ids="{{ atual.videos|map(attribute='id')|join(' ') }}"></span>
  </div>
</section>
{% else %}
<p class="card">Nenhuma edição publicada ainda.</p>
{% endif %}

{% if edicoes %}
<section id="edicoes" class="secao">
  <h2>Todas as edições</h2>
  <p class="hand">cada dia de talks vira uma aula</p>
  <div class="cartoes">
    {% for e in edicoes %}
    <a class="cartao" href="edicoes/{{ e.edicao }}.html">
      <span class="label">{{ e.data_fmt }}</span>
      <h3>{{ e.titulo }}</h3>
      <span class="cartao-info">{{ e.videos|length }} {{ "vídeo" if e.videos|length == 1 else "vídeos" }} · {{ e.temas|join(", ") }}</span>
      <span class="progresso" data-ids="{{ e.videos|map(attribute='id')|join(' ') }}"></span>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
