{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abertura de uma edição, escrita pelo orquestrador",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edicao",
    "titulo",
    "abertura",
    "ordem",
    "conceitos_novos",
    "essenciais"
  ],
  "properties": {
    "edicao": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "titulo": {
      "type": "string",
      "minLength": 5,
      "maxLength": 70
    },
    "abertura": {
      "type": "string",
      "minLength": 40,
      "maxLength": 900
    },
    "ordem": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 11,
        "maxLength": 11
      }
    },
    "conceitos_novos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "essenciais": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "os 2 ou 3 talks que valem a leitura completa hoje",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "por_que"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11
          },
          "por_que": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          }
        }
      }
    },
    "dialogos": {
      "type": "array",
      "description": "talks desta edição que conversam com talks anteriores",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "com",
          "relacao",
          "nota"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11
          },
          "com": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11
          },
          "relacao": {
            "enum": [
              "complementa",
              "contradiz",
              "aprofunda"
            ]
          },
          "nota": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          }
        }
      }
    }
  }
}
